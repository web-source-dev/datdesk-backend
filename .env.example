PORT=7020
MONGODB_URI=mongodb://localhost:27017/newdatapp
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=7d
UPLOADS_DIR=./uploads
ALLOWED_ORIGIN=*
UPDATE_DIR=./updates
DEFAULT_UPDATE_APP=datdesk

# FreightDesk partner API (FD Containers page)
FREIGHTDESK_API_URL=https://freightdesk.rtnglobal.co
FREIGHTDESK_PARTNER_API_KEY=change-me

# Swift Solutions partner-admin (X-Partner-Key)
SWIFT_SOLUTIONS_PARTNER_KEY=swift-solutions
# Optional: PARTNER_SWIFT_ACCOUNT_SLOTS=6
# Optional: PARTNER_SWIFT_INCLUDED_SESSION_SUBSTRINGS=aneeq,avva
# Optional: PARTNER_SWIFT_ACCOUNT_COOKIE_IDS=id1,id2

# Backup backends: PRIMARY_ASSET_URL=https://your-vps.example.com

# Email (Gmail send from DAT panel)
# PUBLIC_API_URL=https://datdesk.apexskillzone.com
# EMAIL_SECRET=change-me-email-crypto-key
# Optional Google OAuth (Connect with Google). App Password works without these.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Must match an Authorized redirect URI in Google Cloud Console:
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:7020/email/oauth/callback
# After OAuth, API redirects the browser to this web panel (NEWDATAPP/webredirect):
# OAUTH_WEB_REDIRECT_URL=http://localhost:5174
